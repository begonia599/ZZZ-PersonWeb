# 网站基本信息
VITE_SITE_NAME=你的网站名称
VITE_SITE_AUTHOR=你的名字
VITE_SITE_SLOGAN=你的网站标语

# ICP备案号（选填，国内服务器需要，国外服务器可留空）
VITE_ICP_BEIAN=你的ICP备案号

# 公安备案号（选填，没有则留空）
VITE_GONGAN_BEIAN=
# 公安备案记录代码（选填，与公安备案号配合使用）
VITE_GONGAN_RECORD_CODE=

# 关于我 - 个人信息
VITE_AVATAR_URL=/images/avatar.jpg
VITE_USER_NAME=你的昵称
VITE_USER_BIO=一句话简介
VITE_USER_DESCRIPTION=详细的个人介绍
# 用户标签（用逗号分隔）
VITE_USER_TAGS=标签1,标签2,标签3

# 社交平台链接（不需要的可以留空）
VITE_SOCIAL_GITHUB=https://github.com/your-username
VITE_SOCIAL_BILIBILI=https://space.bilibili.com/your-id
VITE_SOCIAL_WEIBO=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_ZHIHU=
VITE_SOCIAL_JUEJIN=
VITE_SOCIAL_CSDN=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_EMAIL=
VITE_SOCIAL_BLOG=
VITE_SOCIAL_QQ=
VITE_SOCIAL_WECHAT=

# Live2D 模型配置
VITE_LIVE2D_MODEL_PATH=/live2d_models/furina/
